# Copy to .env and fill in. Nothing here is ever committed.

# the app's database, read only: the experiments never write to it, e.g. the local one of start_local.sh
QUBIT_NOTES_EXPERIMENT_APP_DATABASE_URL=postgresql+psycopg://qubit:qubit@127.0.0.1:5433/qubit_notes_dev
# whose material samples are drawn from: the student's id, as the app's database has it
QUBIT_NOTES_EXPERIMENT_STUDENT=

# the models' provider
ANTHROPIC_API_KEY=

# the cheapest model, which the scenarios run every agent on
QUBIT_NOTES_EXPERIMENT_TEST_MODEL=anthropic:claude-haiku-5-5

# Langfuse, a project of the experiments' own, apart from the app's; without its keys, experiments are kept here only
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# the app's Langfuse project's public key, to check the experiments never trace into it
QUBIT_NOTES_EXPERIMENT_APP_LANGFUSE_PUBLIC_KEY=
